<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>sample</artifactId>
  <version>1.0</version>

  <!-- CalculatorTest imports org.junit.Test, so the dependency has to be
       declared: without it the fixture compiles its main sources and then
       fails at testCompile, which is a real (and correctly reported) error
       rather than anything the runner can work around. -->
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
